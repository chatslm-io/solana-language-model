# Copy to .env.local, or use node --env-file=/your/chosen/file.
# Blank credentials, addresses and toolchain paths must be filled by the operator.
# Paths can be absolute or relative to the working directory; no shell expansion.
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=
SLM_SIGNER_ENV_FILE=.local/operator.env
SLM_OPERATOR_DIR=.local/operator
SLM_LOCAL_ORIGIN=http://127.0.0.1:3000

# Mainnet on-chain inference using an already uploaded, sealed model.
SLM_INFERENCE_PROGRAM_ID=
SLM_MODEL_OWNER=
SLM_MODEL_NONCE=
SLM_INFERENCE_STATE_DIR=.local/inference
SLM_UPLOAD_STATE_DIR=.local/model-uploads
# Fill after reviewing model:upload:mainnet -- --quote.
SLM_UPLOAD_MAX_LAMPORTS=
# Explicit maximum total reservation in lamports, including session rent and fees.
SLM_INFERENCE_MAX_LAMPORTS=
SLM_PROMPT_TOKENS=[1]
SLM_OUTPUT_TOKENS=1
SLM_MODEL_IDENTITY_FILE=.local/model-identity.json

# Mainnet-clone tests: upstream is read-only; the validator signs locally.
SLM_CLONE_RPC_URL=
SLM_PUBLIC_FULL_UPLOAD=0
# Optional clone wallets. Unconfigured slots generate fresh in-memory wallets.
# Slot 1 also accepts SLM_KEYPAIR_PATH/SLM_PRIVATE_KEY from the signer config.
SLM_CLONE_KEYPAIR_PATH_1=
SLM_CLONE_KEYPAIR_PATH_2=

# Build tools: platform-tools v1.58; Rust 1.95.0-dev (1e20dd0d5).
SLM_SBF_PLATFORM_TOOLS=
CARGO_HOME=.local/cargo
SLM_APPROVED_SIGNER_1=
SLM_APPROVED_SIGNER_2=
SLM_STORAGE_BUILD_DIR=.local/build/storage
SLM_PUBLIC_BUILD_DIR=.local/build/public
SLM_PUBLIC_KERNEL_BUILD_DIR=.local/build/kernel
SLM_PRIVATE_BUILD_DIR=.local/build/private
SLM_PRIVATE_CRYPTO_BUILD_DIR=.local/build/crypto
SLM_PROGRAM_BINARY=.local/build/storage/sbpf-solana-solana/release/slm_storage.so
SLM_PROGRAM_BUILD_FILE=.local/build/storage/build.json

# Optional storage UI and program deployment tools.
SLM_LOCALNET_STORAGE_PROGRAM_ID=
SLM_DEVNET_STORAGE_PROGRAM_ID=
SLM_MAINNET_STORAGE_PROGRAM_ID=
SLM_DEVNET_RPC_URL=
SLM_MAINNET_RPC_URL=
SLM_DEPLOYMENT_DIR=.local/deployments
SLM_DEPLOYMENT_ENV_FILE=.local/operator.env
SLM_PRIVATE_LINEAR_STATE_DIR=.local/private-linear
SLM_PROOF_MANIFEST_SHA256=
SLM_MAX_DEPOSIT_SOL=0.01
SLM_MAX_FEE_SOL=0.001
SLM_MAX_TRANSACTIONS=100
SLM_RPC_MODE=free
SLM_RPC_RPS=50
SLM_RPC_SEND_RPS=5
SLM_RPC_SCAN_RPS=25

# Optional checkpoint download UI.
HF_DOWNLOAD_DIR=.local/models
HF_TOKEN=
SLM_MAX_DOWNLOAD_BYTES=21474836480
