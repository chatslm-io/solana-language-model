# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
operator.env
*.env
operator-state/

# Signing material, model data and operator state never belong in Git.
**/*keypair*.json
**/wallet*.json
**/id.json
*.key
*.keystore
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx
/models/
/downloads/
/data/
/program/target/
/recovery/dist/
/test-results/
/playwright-report/
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.bytes
*.part
*.so

# Isolated experimental program build artifacts
/private-linear-program/target/

# Local credentials, build outputs and development metadata
**/target/
**/__pycache__/
*.pyc
/.agents/
/.aws/
/.codex/
/AGENTS.md
/CLAUDE.md

# User-selected local configuration, state and build outputs
/.local/
