{
  "name": "slm-onchain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/formats.test.ts tests/security.test.ts tests/transactions.test.ts",
    "test:program": "node --import tsx --test tests/program.test.ts",
    "test:e2e": "playwright test",
    "program:build": "node scripts/build-program.mjs",
    "configure-program": "tsx scripts/configure-program.ts",
    "verify": "tsx scripts/verify.ts",
    "recovery:build": "node recovery/build.mjs",
    "recovery": "node recovery/build.mjs && tsx --env-file-if-exists=.env.local recovery/server.ts",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "operator:setup": "tsx scripts/setup-operator.ts",
    "reclaim:local": "tsx scripts/reclaim-local.ts",
    "reclaim:buffer": "tsx scripts/reclaim-program-buffer.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "manifest:publish": "tsx scripts/publish-manifest.ts",
    "test:receipts": "node --import tsx --test tests/receipts*.test.ts",
    "private-inference:build": "node private-inference/crypto-core/build.mjs && node private-inference/harness/build.mjs && node private-inference/harness/build.mjs --test-only-mock && node private-inference/harness/build.mjs --experimental-half-gates && node private-inference/harness/build.mjs --experimental-circuit && node private-inference/harness/build.mjs --experimental-stream",
    "private-inference:test:crypto": "node --import tsx --test --test-reporter=spec private-inference/crypto-core/tests/*.test.ts private-inference/tests/client-*.test.ts",
    "private-inference:test:sbf": "node --import tsx --test --test-reporter=spec private-inference/protocol/*.test.ts private-inference/crypto-core/tests/*.test.ts private-inference/tests/lifecycle*.test.ts private-inference/tests/fork-runner.test.ts",
    "private-inference:test:unit": "node --import tsx --test --test-reporter=spec private-inference/protocol/*.test.ts private-inference/tests/model-*.test.ts private-inference/tests/client-*.test.ts private-inference/tests/fork-transport.test.ts",
    "private-inference:test:fork": "node --import tsx private-inference/harness/fork.ts",
    "public-inference:build": "node public-inference/kernel/build.mjs && node public-inference/harness/build.mjs",
    "public-inference:test:unit": "node --import tsx --test --test-reporter=spec public-inference/tests/protocol.test.ts public-inference/tests/model-*.test.ts public-inference/tests/client-*.test.ts",
    "public-inference:test:sbf": "node --import tsx --test --test-reporter=spec public-inference/kernel/tests/*.test.ts public-inference/tests/lifecycle*.test.ts public-inference/tests/fork-confirmation.test.ts public-inference/tests/fork-receipt-pruning.test.ts",
    "public-inference:test:fork": "node --import tsx public-inference/harness/fork.ts",
    "public-inference:test:tokenizer": "node --import tsx --test --test-reporter=spec public-inference/tests/client-tokenizer*.test.ts public-inference/tests/lifecycle-tokenizer*.test.ts",
    "public-inference:test:confirmation": "node --import tsx --test --test-reporter=spec public-inference/tests/fork-confirmation.test.ts public-inference/tests/client-transport.test.ts public-inference/tests/fork-receipt-pruning.test.ts",
    "public-inference:test:batch": "node --import tsx --test --test-reporter=spec public-inference/tests/model-batches.test.ts public-inference/tests/model-batch-runner.test.ts public-inference/tests/lifecycle-batch*.test.ts",
    "public-inference:test:reuse": "node --import tsx --test --test-reporter=spec public-inference/tests/client-retained-ledger.test.ts public-inference/tests/client-target-cache.test.ts public-inference/tests/model-fixture-reuse.test.ts",
    "public-inference:test:cleanup": "node --import tsx --test --test-reporter=spec public-inference/tests/lifecycle-cleanup-group.test.ts public-inference/tests/lifecycle-fork-runner.test.ts",
    "public-inference:test:upload-restart": "node --import tsx --test --test-reporter=spec public-inference/tests/upload-transactions.test.ts public-inference/tests/lifecycle-upload-restart.test.ts",
    "public-inference:test:execution-mode": "node --import tsx --test --test-reporter=spec public-inference/tests/client-execution-mode.test.ts public-inference/tests/lifecycle-execution-mode.test.ts public-inference/tests/lifecycle-allowlist.test.ts public-inference/tests/lifecycle-inference-memo.test.ts public-inference/tests/lifecycle-receipt-publisher.test.ts",
    "inference:mainnet": "node --env-file-if-exists=.env.local --import tsx scripts/inference-mainnet.ts",
    "model:upload:mainnet": "node --env-file-if-exists=.env.local --import tsx scripts/model-upload-mainnet.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@solana/kit": "8.5.0",
    "@solana/rpc-spec-types": "8.5.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@solana/web3.js": "3.1.1",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "jsonc-parser": "3.3.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "litesvm": "1.6.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
