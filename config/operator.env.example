# Copy to your chosen SLM_SIGNER_ENV_FILE and chmod 600.
# Choose one key source. Relative paths resolve from the command's working directory.
# Example path: .local/wallet.json. Leave blank for clone-only generated wallets.
SLM_KEYPAIR_PATH=
SLM_PRIVATE_KEY=
SLM_OPERATOR_DIR=.local/operator
SLM_DEVNET_RPC_URL=
SLM_MAINNET_RPC_URL=
SLM_DEVNET_STORAGE_PROGRAM_ID=
SLM_MAINNET_STORAGE_PROGRAM_ID=
SLM_MAX_DEPOSIT_SOL=0.01
SLM_MAX_FEE_SOL=0.001
SLM_MAX_TRANSACTIONS=100
SLM_RPC_MODE=free
SLM_RPC_RPS=50
SLM_RPC_SEND_RPS=5
SLM_RPC_SCAN_RPS=25
SLM_PROGRAM_BINARY=.local/build/storage/sbpf-solana-solana/release/slm_storage.so
SLM_PROGRAM_BUILD_FILE=.local/build/storage/build.json

# Optional clone wallet overrides and matching public allowlist entries.
SLM_CLONE_KEYPAIR_PATH_1=
SLM_CLONE_KEYPAIR_PATH_2=
SLM_APPROVED_SIGNER_1=
SLM_APPROVED_SIGNER_2=
